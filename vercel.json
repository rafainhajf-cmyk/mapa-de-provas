{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": { "api/gateway.mjs": { "includeFiles": "private-content/**", "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/gateway?__study_path=$1" }]
}
